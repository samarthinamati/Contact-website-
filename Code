<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>pujariGo - Privacy Policy & Contact Us</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        saffron: {
                            50: '#fff7ed',
                            100: '#ffedd5',
                            500: '#f97316',
                            600: '#ea580c',
                            700: '#c2410c',
                        }
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-slate-50 text-slate-800 font-sans antialiased selection:bg-saffron-500 selection:text-white">

    <!-- Navigation -->
    <nav class="sticky top-0 z-50 bg-white/90 backdrop-blur-md border-b border-slate-200 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16 items-center">
                <div class="flex items-center space-x-3">
                    <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-saffron-600 to-amber-500 flex items-center justify-center text-white shadow-md shadow-saffron-500/20">
                        <i class="fa-solid fa-om text-xl"></i>
                    </div>
                    <span class="text-xl font-bold bg-gradient-to-r from-saffron-600 to-amber-600 bg-clip-text text-transparent">pujariGo</span>
                </div>
                <div class="hidden md:flex items-center space-x-8 text-sm font-medium text-slate-600">
                    <a href="#overview" class="hover:text-saffron-600 transition-colors">Overview</a>
                    <a href="#privacy" class="hover:text-saffron-600 transition-colors">Privacy Policy</a>
                    <a href="#contact" class="hover:text-saffron-600 transition-colors">Contact Us</a>
                </div>
                <div>
                    <a href="#contact" class="inline-flex items-center px-4 py-2 rounded-xl bg-saffron-600 text-white text-sm font-medium hover:bg-saffron-700 transition-all shadow-md shadow-saffron-600/20">
                        Get Support
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <header id="overview" class="relative overflow-hidden bg-gradient-to-b from-saffron-50 via-white to-slate-50 pt-16 pb-20 border-b border-slate-200">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
            <span class="inline-flex items-center gap-1.5 py-1.5 px-3 rounded-full text-xs font-semibold bg-saffron-100 text-saffron-700 mb-6">
                <i class="fa-solid fa-shield-halved"></i> Official Compliance Portal
            </span>
            <h1 class="text-4xl sm:text-5xl font-extrabold text-slate-900 tracking-tight mb-6">
                Privacy Policy & Support for <span class="bg-gradient-to-r from-saffron-600 to-amber-600 bg-clip-text text-transparent">pujariGo</span>
            </h1>
            <p class="text-lg text-slate-600 max-w-2xl mx-auto mb-8">
                pujariGo connects devotees and customers with verified saints and pujaris for sacred rituals and spiritual services. Your trust and privacy are our top priorities.
            </p>
            <div class="flex flex-wrap justify-center gap-4 text-sm text-slate-500">
                <div class="flex items-center gap-2 bg-white px-4 py-2 rounded-lg border border-slate-200 shadow-sm">
                    <i class="fa-solid fa-phone text-saffron-600"></i>
                    <span>+91 76766 86728</span>
                </div>
                <div class="flex items-center gap-2 bg-white px-4 py-2 rounded-lg border border-slate-200 shadow-sm">
                    <i class="fa-solid fa-envelope text-saffron-600"></i>
                    <span>samarthinamti@gmail.com</span>
                </div>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-12">

        <!-- Privacy Policy Card -->
        <section id="privacy" class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 sm:p-10 space-y-8">
            <div class="border-b border-slate-100 pb-6">
                <h2 class="text-2xl font-bold text-slate-900 flex items-center gap-3">
                    <i class="fa-solid fa-file-contract text-saffron-600"></i> Privacy Policy
                </h2>
                <p class="text-sm text-slate-500 mt-1">Last updated: October 13, 2026</p>
            </div>

            <div class="space-y-6 text-slate-600 leading-relaxed text-sm sm:text-base">
                <div>
                    <h3 class="text-lg font-semibold text-slate-900 mb-2">1. Introduction</h3>
                    <p>Welcome to <strong>pujariGo</strong> ("we", "our", or "us"). We are committed to protecting your personal information and your right to privacy. This Privacy Policy explains how we collect, use, and safeguard your information when you use our mobile application.</p>
                </div>

                <div>
                    <h3 class="text-lg font-semibold text-slate-900 mb-2">2. Information We Collect</h3>
                    <p class="mb-3">We collect personal information that you voluntarily provide to us when registering on the application. Depending on your role, we collect specific information:</p>
                    
                    <div class="grid sm:grid-cols-2 gap-4 mt-4">
                        <div class="bg-slate-50 p-4 rounded-xl border border-slate-200">
                            <h4 class="font-semibold text-slate-900 mb-2 flex items-center gap-2">
                                <i class="fa-solid fa-user-tie text-saffron-600"></i> Saint / Pujari Account
                            </h4>
                            <ul class="list-disc pl-5 space-y-1 text-slate-600 text-sm">
                                <li>Username / Full Name</li>
                               <li>Phone Number</li>
                                <li>Password (secured authentication)</li>
                            </ul>
                        </div>
                        <div class="bg-slate-50 p-4 rounded-xl border border-slate-200">
                            <h4 class="font-semibold text-slate-900 mb-2 flex items-center gap-2">
                                <i class="fa-solid fa-user text-saffron-600"></i> Customer Account
                            </h4>
                            <ul class="list-disc pl-5 space-y-1 text-slate-600 text-sm">
                                <li>Username / Name</li>
                                <li>Phone Number (used directly for sign-in & identification)</li>
                            </ul>
                        </div>
                    </div>
                </div>

                <div>
                    <h3 class="text-lg font-semibold text-slate-900 mb-2">3. Account Sign-In & Authentication Workflows</h3>
                    <p class="mb-2">We maintain secure and distinct sign-in mechanisms for our users:</p>
                    <ul class="list-disc pl-5 space-y-2">
                        <li><strong>Saint Accounts:</strong> Saints sign into their accounts using their registered <strong>Phone Number</strong> and secure <strong>Password</strong>.</li>
                        <li><strong>Customer Accounts:</strong> Customers sign into their accounts directly using their registered <strong>Phone Number</strong>.</li>
                    </ul>
                </div>

                <div>
                    <h3 class="text-lg font-semibold text-slate-900 mb-2">4. How We Use Your Information</h3>
                    <p>We use the information we collect to:</p>
                    <ul class="list-disc pl-5 space-y-1 mt-2">
                        <li>Create and manage your user or saint profile.</li>
                        <li>Facilitate connection and booking services between customers and saints.</li>
                        <li>Provide customer support, inquiries, and technical notifications.</li>
                        <li>Ensure app security and prevent fraudulent access.</li>
                    </ul>
                </div>

                <div>
                    <h3 class="text-lg font-semibold text-slate-900 mb-2">5. Data Security</h3>
                    <p>We implement appropriate technical and organizational security measures designed to protect the security of any personal information we process. However, please also remember that no method of transmission over the internet is 100% secure.</p>
                </div>

                <div>
                    <h3 class="text-lg font-semibold text-slate-900 mb-2">6. Contact Us</h3>
                    <p>If you have questions or comments about this policy, you may contact us at:</p>
                    <div class="mt-3 bg-saffron-50 p-4 rounded-xl border border-saffron-100 text-slate-700 space-y-1">
                        <p><strong>Region:</strong> Karnataka, India</p>
                        <p><strong>Phone:</strong> +91 76766 86728</p>
                        <p><strong>Email:</strong> samarthinamti@gmail.com</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Contact Us Section -->
        <section id="contact" class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 sm:p-10 space-y-8">
            <div class="border-b border-slate-100 pb-6">
                <h2 class="text-2xl font-bold text-slate-900 flex items-center gap-3">
                    <i class="fa-solid fa-headset text-saffron-600"></i> Contact Us
                </h2>
                <p class="text-sm text-slate-500 mt-1">Have questions about the pujariGo app or need support? Reach out to us directly.</p>
            </div>

            <div class="grid md:grid-cols-2 gap-8">
                <div class="space-y-6">
                    <div class="flex items-start space-x-4">
                        <div class="w-12 h-12 rounded-xl bg-saffron-50 text-saffron-600 flex items-center justify-center flex-shrink-0 text-lg">
                            <i class="fa-solid fa-phone"></i>
                        </div>
                        <div>
                            <h3 class="font-semibold text-slate-900">Phone Support</h3>
                            <p class="text-sm text-slate-500 mt-0.5">Mon-Sat from 9am to 6pm IST</p>
                            <a href="tel:+917676686728" class="text-saffron-600 font-medium text-sm mt-1 inline-block hover:underline">+91 76766 86728</a>
                        </div>
                    </div>

                    <div class="flex items-start space-x-4">
                        <div class="w-12 h-12 rounded-xl bg-saffron-50 text-saffron-600 flex items-center justify-center flex-shrink-0 text-lg">
                            <i class="fa-solid fa-envelope"></i>
                        </div>
                        <div>
                            <h3 class="font-semibold text-slate-900">Email Address</h3>
                            <p class="text-sm text-slate-500 mt-0.5">We respond within 24 hours</p>
                            <a href="mailto:samarthinamti@gmail.com" class="text-saffron-600 font-medium text-sm mt-1 inline-block hover:underline">samarthinamti@gmail.com</a>
                        </div>
                    </div>

                    <div class="flex items-start space-x-4">
                        <div class="w-12 h-12 rounded-xl bg-saffron-50 text-saffron-600 flex items-center justify-center flex-shrink-0 text-lg">
                            <i class="fa-solid fa-location-dot"></i>
                        </div>
                        <div>
                            <h3 class="font-semibold text-slate-900">Location</h3>
                            <p class="text-sm text-slate-500 mt-0.5">Karnataka, India</p>
                        </div>
                    </div>
                </div>

                <!-- Contact Form -->
                <form id="contactForm" class="space-y-4 bg-slate-50 p-6 rounded-xl border border-slate-200" onsubmit="handleFormSubmit(event)">
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 uppercase mb-1">Your Name</label>
                        <input type="text" required class="w-full px-4 py-2.5 rounded-lg border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-saffron-500 bg-white" placeholder="Enter your name">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 uppercase mb-1">Phone Number or Email</label>
                        <input type="text" required class="w-full px-4 py-2.5 rounded-lg border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-saffron-500 bg-white" placeholder="Enter phone or email">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 uppercase mb-1">Message</label>
                        <textarea rows="4" required class="w-full px-4 py-2.5 rounded-lg border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-saffron-500 bg-white" placeholder="How can we help you?"></textarea>
                    </div>
                    <button type="submit" class="w-full py-3 rounded-lg bg-saffron-600 text-white font-medium text-sm hover:bg-saffron-700 transition-colors shadow-md shadow-saffron-600/20">
                        Send Message
                    </button>
                    <p id="formSuccess" class="hidden text-center text-xs text-emerald-600 font-medium mt-2">Thank you! Your message has been sent successfully.</p>
                </form>
            </div>
        </section>
    </main>

    <!-- Footer -->
    <footer class="bg-white border-t border-slate-200 mt-20 py-8 text-center text-sm text-slate-500">
        <div class="max-w-7xl mx-auto px-4 space-y-2">
            <p>&copy; 2026 pujariGo. All rights reserved.</p>
            <p class="text-xs text-slate-400">Designed for Google Play Store Submission</p>
        </div>
    </footer>

    <script>
        function handleFormSubmit(e) {
            e.preventDefault();
            const successMsg = document.getElementById('formSuccess');
            successMsg.classList.remove('hidden');
            e.target.reset();
            setTimeout(() => {
                successMsg.classList.add('hidden');
            }, 5000);
        }
    </script>
</body>
</html>
